@model Soundora.Presentation.Models.Subscriptions.AssignPackageViewModel

@{
    ViewData["Title"] = "Paket Ata";
}

<section class="breadcumb-area bg-img bg-overlay"
         style="background-image: url('@Url.Content("~/one-music-gh-pages/img/bg-img/bg-2.jpg")');">
    <div class="bradcumbContent">
        <p>Abonelik Yönetimi</p>
        <h2>Paket Ata</h2>
    </div>
</section>

<section class="section-padding-100">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">

                @if (TempData["Success"] is string successMessage)
                {
                    <div class="alert alert-success" role="alert">
                        @successMessage
                    </div>
                }

                <div class="alert alert-info">
                    Seçilen paket hemen başlar. Kullanıcının önceki
                    aktif aboneliği kapatılır ve kalan süresi aktarılmaz.
                </div>

                @if (Model.Users.Count == 0 || Model.Packages.Count == 0)
                {
                    <div class="alert alert-warning">
                        Paket atamak için kayıtlı bir kullanıcı ve
                        geçerli, aktif bir paket bulunmalıdır.
                    </div>
                }

                <form asp-area="Admin"
                      asp-controller="Subscriptions"
                      asp-action="Assign"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="form-group">
                        <label asp-for="Input.UserId">Kullanıcı</label>

                        <select asp-for="Input.UserId"
                                asp-items="Model.Users"
                                class="form-control">
                            <option value="">Kullanıcı seçiniz</option>
                        </select>

                        <span asp-validation-for="Input.UserId"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.PackageId">Paket</label>

                        <select asp-for="Input.PackageId"
                                asp-items="Model.Packages"
                                class="form-control">
                            <option value="">Paket seçiniz</option>
                        </select>

                        <span asp-validation-for="Input.PackageId"
                              class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn oneMusic-btn">
                        Paket Ata
                    </button>

                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-outline-secondary ml-2">
                        Ana Sayfaya Dön
                    </a>

                </form>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />
}
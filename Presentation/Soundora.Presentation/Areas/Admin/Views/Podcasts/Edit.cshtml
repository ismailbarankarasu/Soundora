@model Soundora.Presentation.Models.Podcasts.UpdatePodcastViewModel

@{
    ViewData["Title"] = "Podcast Güncelle";
}

<section class="breadcumb-area bg-img bg-overlay"
         style="background-image: url('@Url.Content("~/one-music-gh-pages/img/bg-img/bg-2.jpg")');">
    <div class="bradcumbContent">
        <p>Podcast Yönetimi</p>
        <h2>Podcast Güncelle</h2>
    </div>
</section>

<section class="section-padding-100">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">

                <div class="alert alert-info">
                    Podcastler Gold aboneliğiyle dinlenebilir.
                </div>

                <form asp-area="Admin"
                      asp-controller="Podcasts"
                      asp-action="Edit"
                      asp-route-id="@Model.Input.Id"
                      method="post"
                      enctype="multipart/form-data">

                    <input asp-for="Input.Id" type="hidden">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="form-group">
                        <label asp-for="Input.Title">Podcast Adı</label>

                        <input asp-for="Input.Title"
                               class="form-control">

                        <span asp-validation-for="Input.Title"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.Description">Açıklama</label>

                        <textarea asp-for="Input.Description"
                                  class="form-control"
                                  rows="4"></textarea>

                        <span asp-validation-for="Input.Description"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.CategoryId">Kategori</label>

                        <select asp-for="Input.CategoryId"
                                asp-items="Model.Categories"
                                class="form-control">
                            <option value="">Kategori seçiniz</option>
                        </select>

                        <span asp-validation-for="Input.CategoryId"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.ArtistId">Sunucu</label>

                        <select asp-for="Input.ArtistId"
                                asp-items="Model.Hosts"
                                class="form-control">
                            <option value="">Sunucu belirtilmedi</option>
                        </select>

                        <span asp-validation-for="Input.ArtistId"
                              class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        @if (!string.IsNullOrWhiteSpace(Model.Input.CoverImagePath))
                        {
                            <div class="mb-3">
                                <p>Mevcut Kapak</p>

                                <img src="@Url.Content(Model.Input.CoverImagePath)"
                                     alt="Mevcut podcast kapağı"
                                     style="width: 180px; height: 180px; object-fit: cover;">
                            </div>
                        }

                        <label asp-for="CoverImage">Yeni Kapak Görseli</label>

                        <input asp-for="CoverImage"
                               type="file"
                               accept=".jpg,.jpeg,.png"
                               class="form-control-file">

                        <small class="form-text text-muted">
                            JPG veya PNG, en fazla 5 MB.
                            Yeni görsel seçmezseniz mevcut kapak korunur.
                        </small>

                        <span asp-validation-for="CoverImage"
                              class="text-danger"></span>
                    </div>
                    <div class="form-group form-check">
                        <input asp-for="Input.IsActive"
                               class="form-check-input">

                        <label asp-for="Input.IsActive"
                               class="form-check-label">
                            Aktif
                        </label>
                    </div>

                    <button type="submit"
                            class="btn oneMusic-btn">
                        Güncelle
                    </button>

                    <a asp-area="Admin"
                       asp-controller="Podcasts"
                       asp-action="Index"
                       class="btn btn-outline-secondary ml-2">
                        İptal
                    </a>

                </form>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />
}
@model UpdatePackageRequest

@{
    ViewData["Title"] = "Paket Güncelle";
}

<section class="breadcumb-area bg-img bg-overlay"
         style="background-image: url('@Url.Content("~/one-music-gh-pages/img/bg-img/bg-2.jpg")');">
    <div class="bradcumbContent">
        <p>Paket Yönetimi</p>
        <h2>Paket Güncelle</h2>
    </div>
</section>

<section class="section-padding-100">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">

                <div class="alert alert-warning">
                    Erişim seviyesinin değiştirilmesi veya paketin pasif
                    yapılması mevcut abonelerin erişimini etkiler.
                    Süre değişikliği yalnızca yeni paket atamalarında uygulanır.
                </div>

                <form asp-area="Admin"
                      asp-controller="Packages"
                      asp-action="Edit"
                      asp-route-id="@Model.Id"
                      method="post">

                    <input asp-for="Id" type="hidden">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="form-group">
                        <label asp-for="Name">Paket Adı</label>
                        <input asp-for="Name" class="form-control">
                        <span asp-validation-for="Name"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Description">Açıklama</label>
                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="4"></textarea>
                        <span asp-validation-for="Description"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Price">Fiyat (TL)</label>
                        <input asp-for="Price"
                               class="form-control"
                               type="text"
                               inputmode="decimal">
                        <span asp-validation-for="Price"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="DurationInDays">Süre (Gün)</label>
                        <input asp-for="DurationInDays"
                               class="form-control"
                               type="number"
                               min="1"
                               max="3650">
                        <span asp-validation-for="DurationInDays"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="AccessLevel">Erişim Seviyesi</label>
                        <select asp-for="AccessLevel" class="form-control">
                            <option value="1">Basic</option>
                            <option value="2">Gold</option>
                        </select>
                        <span asp-validation-for="AccessLevel"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group form-check">
                        <input asp-for="IsActive"
                               class="form-check-input">
                        <label asp-for="IsActive"
                               class="form-check-label">
                            Aktif
                        </label>
                    </div>

                    <button type="submit" class="btn oneMusic-btn">
                        Güncelle
                    </button>

                    <a asp-area="Admin"
                       asp-controller="Packages"
                       asp-action="Index"
                       class="btn btn-outline-secondary ml-2">
                        İptal
                    </a>

                </form>

            </div>
        </div>
    </div>
</section>
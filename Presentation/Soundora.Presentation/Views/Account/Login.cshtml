@model Soundora.Application.Authentication.Models.LoginRequest

@{
    ViewData["Title"] = "Giriş Yap";
    Layout = "~/Views/Shared/_UI_Layout.cshtml";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<section class="breadcumb-area bg-img bg-overlay"
         style="background-image: url('@Url.Content("~/one-music-gh-pages/img/bg-img/breadcumb3.jpg")');">
    <div class="bradcumbContent">
        <p>Kaldığın yerden dinlemeye devam et</p>
        <h2>Giriş Yap</h2>
    </div>
</section>

<section class="login-area section-padding-100">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">

                @if (TempData["SuccessMessage"] is string message)
                {
                    <div class="alert alert-success" role="status">
                        @message
                    </div>
                }

                <div class="login-content">
                    <h3>Soundora'ya Hoş Geldin</h3>

                    <p class="mb-4">
                        Favori müziklerine ve podcastlerine ulaşmak için
                        hesabına giriş yap.
                    </p>

                    <div class="login-form">
                        <form asp-area=""
                              asp-controller="Account"
                              asp-action="Login"
                              asp-route-returnUrl="@returnUrl"
                              method="post">

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger text-left mb-3"
                                 role="alert">
                            </div>

                            <div class="form-group">
                                <label asp-for="UserName">
                                    Kullanıcı Adı
                                </label>

                                <input asp-for="UserName"
                                       class="form-control"
                                       autocomplete="username"
                                       placeholder="Kullanıcı adını gir">

                                <span asp-validation-for="UserName"
                                      class="text-danger d-block mt-1"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="Password">
                                    Şifre
                                </label>

                                <input asp-for="Password"
                                       type="password"
                                       class="form-control"
                                       autocomplete="current-password"
                                       placeholder="Şifreni gir">

                                <span asp-validation-for="Password"
                                      class="text-danger d-block mt-1"></span>
                            </div>

                            <button type="submit"
                                    class="btn oneMusic-btn mt-30">
                                Giriş Yap
                                <i class="fa fa-angle-double-right"
                                   aria-hidden="true"></i>
                            </button>

                            <p class="mt-4 mb-0">
                                Henüz hesabın yok mu?
                                <a asp-area=""
                                   asp-controller="Account"
                                   asp-action="Register"
                                   class="font-weight-bold">
                                    Kayıt ol
                                </a>
                            </p>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@model System.Collections.Generic.IReadOnlyList<Soundora.Application.Podcasts.Models.PodcastDto>

<section class="latest-albums-area section-padding-100 bg-gray">
    <div class="container">

        <div class="row">
            <div class="col-12">
                <div class="section-heading style-2">
                    <p>Yeni konular, yeni sesler</p>
                    <h2>Son Eklenen Podcastler</h2>
                </div>
            </div>
        </div>

        <div class="row justify-content-center">

            @if (Model.Count == 0)
            {
                <div class="col-12 text-center">
                    <p>Henüz podcast eklenmedi.</p>
                </div>
            }
            else
            {
                @foreach (var podcast in Model)
                {
                    var coverImageUrl =
                        string.IsNullOrWhiteSpace(podcast.CoverImageUrl)
                            ? Url.Content("~/one-music-gh-pages/img/bg-img/bg-2.jpg")
                            : Url.Content(podcast.CoverImageUrl);

                    var minutes = podcast.DurationInSeconds / 60;
                    var seconds = podcast.DurationInSeconds % 60;
                    var durationText = $"{minutes}:{seconds:D2}";

                    <div class="col-12 col-sm-6 col-lg-4">
                        <div class="single-album-area mb-30">

                            <div class="album-thumb">
                                <img src="@coverImageUrl"
                                     alt="@podcast.Title"
                                     loading="lazy"
                                     style="width: 100%; aspect-ratio: 1; object-fit: cover;">
                            </div>

                            <div class="album-info">
                                <h5>@podcast.Title</h5>
                                <p>@podcast.HostName</p>
                                <p>@podcast.CategoryName · @durationText</p>

                                <span class="badge badge-warning">
                                    Gold
                                </span>

                                <div class="mt-3">
                                    @if (User.Identity?.IsAuthenticated == true)
                                    {
                                        <button type="button"
                                                class="btn btn-outline-dark btn-sm js-play-music"
                                                data-playback-url="@Url.Action("Play", "Playback", new { area = "", id = podcast.Id })"
                                                data-title="@podcast.Title">
                                            <i class="fa fa-play"
                                               aria-hidden="true"></i>
                                            Dinle
                                        </button>
                                    }
                                    else
                                    {
                                        <a asp-area=""
                                           asp-controller="Account"
                                           asp-action="Login"
                                           asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                                           class="btn btn-outline-dark btn-sm">
                                            Dinlemek İçin Giriş Yap
                                        </a>
                                    }
                                </div>
                            </div>

                        </div>
                    </div>
                }
            }

        </div>

    </div>
</section>
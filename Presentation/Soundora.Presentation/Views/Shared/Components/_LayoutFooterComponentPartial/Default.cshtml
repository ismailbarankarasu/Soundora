<footer class="footer-area">
    <div class="container">
        <div class="row d-flex flex-wrap align-items-center">

            <div class="col-12 col-md-6">
                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Index"
                   class="text-white">
                    SOUNDORA
                </a>

                <p class="copywrite-text">
                    &copy; @DateTime.Now.Year Soundora.
                    Tüm hakları saklıdır.

                    <br>

                    Template:
                    <a href="https://colorlib.com"
                       target="_blank"
                       rel="noopener noreferrer">
                        Colorlib
                    </a>
                </p>
            </div>

            <div class="col-12 col-md-6">
                <div class="footer-nav">
                    <ul>
                        <li>
                            <a asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                Ana Sayfa
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated != true)
                        {
                            <li>
                                <a asp-area=""
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Giriş Yap
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>

        </div>
    </div>
</footer>
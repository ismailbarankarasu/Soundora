@{
    ViewData["Title"] = "Ana Sayfa";
    Layout = "~/Views/Shared/_UI_Layout.cshtml";

    var musicSearch = Context.Request.Query["search"].ToString();

    var musicPage = int.TryParse(
        Context.Request.Query["page"].ToString(),
        out var requestedMusicPage)
            ? requestedMusicPage
            : 1;

    var podcastSearch = Context.Request.Query["podcastSearch"].ToString();

    var podcastPage = int.TryParse(
        Context.Request.Query["podcastPage"].ToString(),
        out var requestedPodcastPage)
            ? requestedPodcastPage
            : 1;
}

@if (User.Identity?.IsAuthenticated == true)
{
    <form id="playbackTokenForm"
          asp-area=""
          asp-controller="Token"
          asp-action="Create"
          method="post"
          hidden>
    </form>
}

@await Component.InvokeAsync("_HomeSliderComponentPartial")

@await Component.InvokeAsync("_HomeLatestMusicComponentPartial",
    new
    {
        search = musicSearch,
        page = musicPage
    })

@await Component.InvokeAsync("_HomeLatestPodcastComponentPartial",
    new
    {
        search = podcastSearch,
        page = podcastPage
    })
<div class="container">
    <div id="musicPlaybackPanel" class="my-5" hidden>
        <h5 id="playingMusicTitle"></h5>

        <div id="musicPlaybackMessage"
             role="status"
             aria-live="polite"></div>

        <div id="musicPlayerHost" class="mt-3"></div>
    </div>
</div>

@section Scripts {
    <script src="~/js/music-playback.js" asp-append-version="true"></script>
}